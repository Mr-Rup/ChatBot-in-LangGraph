# ============================================================
# Sensitive API Credentials & Secrets
# ============================================================
# NOTE: General configurations (model selection, cache directories,
# LangSmith tracing toggle, project names, and database paths)
# are configured in `config.json` and `backend/models.json`.
# This file is strictly for private keys and tokens.

# Hugging Face Access Token
# Required if using model_type="api" or downloading gated models (e.g., Llama)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here

# LangSmith API Key
# Required only if "tracing" is enabled in config.json
# Get your key from: https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here
