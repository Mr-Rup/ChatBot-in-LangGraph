# ============================================================
# Hugging Face Configuration
# ============================================================
# Hugging Face User Access Token
# Required if using model_type="api" or accessing gated repositories (e.g., Llama, Mistral)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here

# Optional: Custom cache path for storing downloaded Hugging Face weights and models
# Default on Windows is usually %USERPROFILE%\.cache\huggingface\hub
# HF_HOME=S:/ollama_models


# ============================================================
# LangSmith Observability & Tracing (Optional)
# ============================================================
# Set to 'true' to log every LangGraph step, tool call, and token to LangSmith
LANGCHAIN_TRACING_V2=false

# Your LangChain API key from https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# The project name under which runs will be organized in LangSmith
LANGCHAIN_PROJECT=ChatBot-LangGraph

# LangSmith endpoint URL
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
